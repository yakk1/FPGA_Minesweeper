#CMD bind stroke-1 -action {}
#CMD bind stroke-nw-1 -action callback -echo_type line -echo_text {Zoom fit} -format (#F7F8F9,#242831,1.0)
module list
#R {first {}}
pagesize
#R 208 272
#CMD bind stroke-ne-1 -action zoom_out -echo_type line -echo_text {Zoom -%z} -format (#F7F8F9,#242831,1.0)
#CMD bind stroke-se-1 -action zoom_in -echo_type rectangle -autoscroll -echo_text {Zoom area} -format (#F7F8F9,#242831,1.0)
#CMD bind stroke-sw-1 -action zoom_in2 -echo_type line -echo_text {Zoom +%z} -format (#F7F8F9,#242831,1.0)
#CMD bind stroke-nw-1 -action zoom_fit -echo_type line -echo_text {Zoom fit} -format (#F7F8F9,#242831,1.0)
property rubberbandfontsize 13
property rubberbandcolor #f7f8f9
module new first -nosplit
